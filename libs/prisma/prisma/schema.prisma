// Prisma 7: pure-TS client generated into this lib and checked in.
// Regenerate after schema changes with `npm run prisma:generate`.
generator client {
  provider = "prisma-client"
  output   = "../src/generated"
  runtime  = "nodejs"
}

datasource db {
  provider = "sqlite"
}

// NOTE: SQLite still has no Decimal (money = integer cents) and Json columns
// cannot carry a DB default (Prisma renders invalid DDL — services write those
// fields explicitly). Enums ARE supported since Prisma 7 (stored as TEXT); the
// value lists must stay in sync with the zod unions in libs/shared.

enum DeviceStatus {
  installed
  stored
  retired
  planned
  broken
}

enum DeviceCategory {
  light
  switch_actor
  sensor
  thermostat
  media
  appliance
  breaker
  junction_box
  outlet
  wall_switch
  network
  hub
  camera
  valve
  pump
  water_heater
  radiator
  fan
  air_handling_unit
  meter
  other
}

enum AttachmentKind {
  manual
  image
  invoice
  diagram
  plan
  other
}

enum ConnectionTypeGroup {
  wired
  wireless
  plumbing
  ventilation
  other
}

enum CapabilityCategory {
  protocol
  network
  power
  other
}

enum EntitySource {
  manual
  ha
}

model Floor {
  id         String       @id @default(cuid())
  name       String
  // HA's floor registry `level` (e.g. 0 = ground floor) — used for ordering.
  level      Int?
  haFloorId  String?      @unique
  haName     String?
  haOrphaned Boolean      @default(false)
  source     EntitySource @default(manual)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  areas Area[]
}

model Area {
  id              String       @id @default(cuid())
  name            String
  floorId         String?
  floor           Floor?       @relation(fields: [floorId], references: [id], onDelete: SetNull)
  notes           String?
  haAreaId        String?      @unique
  haName          String?
  haFloorIdAtSync String?
  haOrphaned      Boolean      @default(false)
  source          EntitySource @default(manual)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  devices     Device[]
  attachments Attachment[]
  diagrams    Diagram[]

  @@index([floorId])
}

model Device {
  id                 String          @id @default(cuid())
  name               String
  category           DeviceCategory?
  manufacturer       String?
  /**
   * Consumer brand when it differs from the legal manufacturer (Frigidaire vs Electrolux).
   */
  brand              String?
  /// HA integration domains this device belongs to, comma-separated (zha,netgear). Sync-maintained.
  haIntegrations     String?
  /// Lower-case MAC addresses from HA's device connections, comma-separated. Drives duplicate hints.
  haMacs             String?
  model              String?
  serialNumber       String?
  purchaseDate       DateTime?
  purchasePriceCents Int?
  purchaseCurrency   String?         @default("EUR")
  purchasedFrom      String?
  productUrl         String?
  notes              String?
  status             DeviceStatus    @default(installed)
  areaId             String?
  area               Area?           @relation(fields: [areaId], references: [id], onDelete: SetNull)
  haDeviceId         String?         @unique
  haName             String?
  haAreaIdAtSync     String?
  haOrphaned         Boolean         @default(false)
  source             EntitySource    @default(manual)
  primaryImageId     String?         @unique
  primaryImage       Attachment?     @relation("DevicePrimaryImage", fields: [primaryImageId], references: [id], onDelete: SetNull)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  attachments     Attachment[]       @relation("DeviceAttachments")
  capabilities    DeviceCapability[]
  autoLinkRules   AutoLinkRule[]
  connectionsFrom Connection[]       @relation("ConnectionFrom")
  connectionsTo   Connection[]       @relation("ConnectionTo")
  diagrams        Diagram[]

  @@index([areaId])
  @@index([status])
  @@index([category])
}

model Attachment {
  id           String         @id @default(cuid())
  kind         AttachmentKind @default(other)
  title        String?
  originalName String
  storedName   String         @unique
  mimeType     String
  sizeBytes    Int
  sha256       String?
  /**
   * Where the file was fetched from when attached via URL (manual lookup);
   * null for direct uploads.
   */
  sourceUrl    String?
  deviceId     String?
  device       Device?        @relation("DeviceAttachments", fields: [deviceId], references: [id], onDelete: Cascade)
  areaId       String?
  area         Area?          @relation(fields: [areaId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())

  primaryImageOf Device?  @relation("DevicePrimaryImage")
  previewOf      Diagram? @relation("DiagramPreview")

  @@index([deviceId])
  @@index([areaId])
}

model CapabilityType {
  id       String             @id @default(cuid())
  key      String             @unique
  label    String
  category CapabilityCategory @default(other)
  isSystem Boolean            @default(false)

  devices DeviceCapability[]
}

model DeviceCapability {
  deviceId         String
  device           Device         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  capabilityTypeId String
  capabilityType   CapabilityType @relation(fields: [capabilityTypeId], references: [id], onDelete: Cascade)
  metadata         Json?
  notes            String?

  @@id([deviceId, capabilityTypeId])
}

// User-editable, unlike CapabilityType only in that there's no join table:
// Connection.type stores this row's `key` as a plain string (like it already
// did back when this was a hardcoded enum — SQLite never enforced it as a
// real enum anyway, see the migration note on 20260726140000), so adding a
// type here doesn't require a migration, and a type that gets deleted just
// leaves any Connection/diagram wire referencing it showing a raw key
// instead of a label — never a broken foreign key.
model ConnectionType {
  id       String              @id @default(cuid())
  key      String              @unique
  label    String
  group    ConnectionTypeGroup @default(other)
  color    String
  // A DashStyle key ("solid" | "dashed" | "dotted" | "dash-dot", see
  // libs/shared/src/lib/dash-style.ts) — not raw SVG stroke-dasharray
  // coordinates, so retuning what "dashed" actually looks like is a
  // one-place change instead of a data migration. Same
  // one-shot-preset-then-independently-editable treatment as color, see
  // EdgeDataSchema.dash in libs/shared.
  dash     String              @default("solid")
  isSystem Boolean             @default(false)
}

model Connection {
  id           String   @id @default(cuid())
  type         String
  // Directed edge: from = upstream/provider end (breaker, switch, coordinator),
  // to = consumer end. UI may render undirected.
  fromDeviceId String
  fromDevice   Device   @relation("ConnectionFrom", fields: [fromDeviceId], references: [id], onDelete: Cascade)
  toDeviceId   String
  toDevice     Device   @relation("ConnectionTo", fields: [toDeviceId], references: [id], onDelete: Cascade)
  label        String?
  metadata     Json?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([fromDeviceId])
  @@index([toDeviceId])
  @@index([type])
}

/// Default controller per connection type for auto-linking: used when HA's
/// registry has no via_device for a device (Wi-Fi gear → the router, say).
model AutoLinkRule {
  type               String   @id
  controllerDeviceId String
  controller         Device   @relation(fields: [controllerDeviceId], references: [id], onDelete: Cascade)
  updatedAt          DateTime @updatedAt
}

/// A user override: an auto-created link they deleted or converted to
/// manual. Keyed by the planner's autoKey so a re-run leaves it alone.
model AutoLinkSuppression {
  autoKey   String   @id
  reason    String
  createdAt DateTime @default(now())
}

/// Hand-arranged node positions on the Network map, one row per layout mode
/// ("radial" | "hierarchy"). positions = { [deviceId]: { x, y } }. Devices
/// without an entry fall back to the computed layout.
model NetworkLayout {
  mode      String   @id
  positions Json
  updatedAt DateTime @updatedAt
}

/// A rule that keeps Home Assistant devices out of the inventory — for
/// virtual devices (Downdetector feeds, add-ons, cloud accounts) that HA
/// registers as ordinary devices. kind: manufacturer | integration | device
/// (value = HA device id).
model SyncExclusion {
  id        String   @id @default(cuid())
  kind      String
  value     String
  label     String?
  createdAt DateTime @default(now())

  @@unique([kind, value])
}

model Diagram {
  id        String   @id @default(cuid())
  title     String
  // ng-diagram serializable model: { schemaVersion: 1, nodes: [...], edges: [...] }.
  // No DB default: Prisma renders Json defaults as invalid (unquoted) SQLite
  // DDL. The service always writes this field explicitly.
  content   Json
  version   Int      @default(1)
  deviceId  String?
  device    Device?  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  areaId    String?
  area      Area?    @relation(fields: [areaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Client-captured PNG snapshot of the canvas, uploaded on save (see
  // diagrams.service.ts#setPreview). Mirrors Device.primaryImage: a
  // dedicated 1:1 Attachment reference, not the general deviceId/areaId
  // gallery FK, so it never shows up as a manageable attachment itself.
  previewAttachmentId String?     @unique
  previewAttachment   Attachment? @relation("DiagramPreview", fields: [previewAttachmentId], references: [id], onDelete: SetNull)

  @@index([deviceId])
  @@index([areaId])
}
